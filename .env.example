VITE_BASE_URL=https://api.starupworld.com/api/v1/
VITE_STORAGE=https://api.starupworld.com
# --- Video upload tuning (optional; sensible defaults are built in) ---------
# Chunk size in MB, as a STARTING point. If the server refuses a chunk this
# large the uploader halves it automatically and carries on, so this does not
# have to be correct -- it only saves a probe round trip when it is. The live
# API measured nginx client_max_body_size 8M, so 4 fits with headroom.
VITE_UPLOAD_CHUNK_MB=4

# How many chunks upload at once. 6 matches the per-host connection limit
# browsers apply on HTTP/1.1; raise it only after enabling HTTP/2 on nginx.
VITE_UPLOAD_CONCURRENCY=6
